# ─── Database ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=password
DB_NAME=patient_module_db
DB_SYNCHRONIZE=false

# Keep DB_SYNCHRONIZE=false for every persistent database. Enable it only for
# an isolated database running with NODE_ENV=test.

# ─── JWT Secrets (use strong random strings in production) ───────────────────
ACCESS_TOKEN_SEC=your_patient_jwt_secret_key_min_32_chars_long
DOCTOR_ACCESS_TOKEN_SEC=your_doctor_jwt_secret_key_min_32_chars_long
ADMIN_ACCESS_TOKEN_SEC=your_admin_jwt_secret_key_min_32_chars_long

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed origins, e.g.:
# CORS_ORIGIN=https://admin.example.com,https://app.example.com
# Required in production — the app refuses to start without it when
# NODE_ENV=production. Left unset here only because local dev allows all
# origins by default.
CORS_ORIGIN=
BCRYPT_ROUNDS=10

# ─── Zoom Server-to-Server OAuth ─────────────────────────────────────────────
# Create a Server-to-Server OAuth app at https://marketplace.zoom.us/
# Grant scopes: meeting:write:admin, meeting:read:admin
ZOOM_ACCOUNT_ID=your_zoom_account_id
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret
ZOOM_HOST_USER_ID=host@example.com

# Optional fallback: use a pre-created Zoom room when OAuth credentials are not set.
# Both patient and doctor receive these links after admin confirms an online appointment.

# Emergency consultation payment
ADDITIONAL_EMERGENCY_FEE=0
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
ZOOM_FALLBACK_JOIN_URL=https://zoom.us/j/your_meeting_id?pwd=your_password
ZOOM_FALLBACK_START_URL=https://zoom.us/s/your_meeting_id?zak=your_host_token
ZOOM_FALLBACK_MEETING_ID=your_meeting_id
ZOOM_FALLBACK_PASSWORD=your_password

# Zoom Webhook Secret Token (from Zoom App > Feature > Event Subscriptions)
# Set the endpoint URL to: https://your-ngrok-url.ngrok.io/api/v1/zoom/webhook
# Subscribe to events: meeting.started, meeting.ended
ZOOM_WEBHOOK_SECRET_TOKEN=your_zoom_webhook_secret_token

# ─── Firebase Cloud Messaging (Push Notifications) ───────────────────────────
# Get this from Firebase Console > Project Settings > Cloud Messaging > Server Key
FCM_SERVER_KEY=your_fcm_server_key
# Public origin used to turn relative profile-image paths into absolute URLs.
# Do not include /api/v1. Example: https://api.example.com
PUBLIC_BASE_URL=http://localhost:3000
